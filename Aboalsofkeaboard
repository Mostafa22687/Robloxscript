local function createPage(pageName, layoutOrder)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(0.31, 0, 1, 0)
    tabBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    tabBtn.Text = pageName
    tabBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextSize = 13
    tabBtn.LayoutOrder = layoutOrder
    tabBtn.ZIndex = 1002
    tabBtn.Parent = navBar
    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 6)

    local pageFrame = Instance.new("ScrollingFrame")
    pageFrame.Size = UDim2.new(1, 0, 1, 0)
    pageFrame.BackgroundTransparency = 1
    pageFrame.ScrollBarThickness = 4
    pageFrame.Visible = false
    pageFrame.ZIndex = 1002
    pageFrame.Parent = pagesContainer
    local pageLayout = Instance.new("UIListLayout", pageFrame)
    pageLayout.Padding = UDim.new(0, 8)

    tabs[layoutOrder] = tabBtn
    pages[layoutOrder] = pageFrame

    tabBtn.MouseButton1Click:Connect(function()
        activeTab = layoutOrder
        for i, page in pairs(pages) do
            page.Visible = (i == layoutOrder)
            tabs[i].BackgroundColor3 = (i == layoutOrder) and currentThemeColor or Color3.fromRGB(25, 25, 35)
            tabs[i].TextColor3 = (i == layoutOrder) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)
        end
    end)
    return pageFrame
end

