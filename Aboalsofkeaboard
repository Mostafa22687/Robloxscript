local currentThemeColor = Color3.fromRGB(200, 40, 40)
local themedBackgrounds = {}
local themedTexts = {}
local themedStrokes = {}

local function changeTheme(newColor)
    currentThemeColor = newColor
    for _, obj in pairs(themedBackgrounds) do if obj then obj.BackgroundColor3 = currentThemeColor end end
    for _, obj in pairs(themedTexts) do if obj then obj.TextColor3 = currentThemeColor end end
    for _, obj in pairs(themedStrokes) do if obj then obj.Color = currentThemeColor end end
end

