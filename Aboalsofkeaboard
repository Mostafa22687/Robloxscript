tpWinBtn.MouseButton1Click:Connect(function()
    if selectedWinBlock then
        winStatus.Text = "جاري البحث..."
        local targetBlock = nil
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name == selectedWinBlock then
                targetBlock = obj
                break
            end
        end

        if targetBlock then
            local wpName = selectedWinBlock .. "_Waypoint"
            local waypoint = Workspace:FindFirstChild(wpName)
            if not waypoint then
                waypoint = Instance.new("Part")
                waypoint.Name = wpName
                waypoint.Size = Vector3.new(4, 0.5, 4)
                waypoint.Position = targetBlock.Position + Vector3.new(3, 3, 0)
                waypoint.Anchored = true
                waypoint.CanCollide = false
                waypoint.Material = Enum.Material.Neon
                waypoint.Color = Color3.fromRGB(40, 200, 40)
                waypoint.Parent = Workspace
            end
            
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.Character.HumanoidRootPart.CFrame = waypoint.CFrame * CFrame.new(0, 3, 0)
                winStatus.Text = "تم الانتقال بنجاح ✅"
