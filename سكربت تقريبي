-- دالة إنشاء زر ميزة (للاستخدام في الجزء الثاني)
------------------------------------------------
function AddFeature(featureName, sectionName, onClick)
	local target = sectionFrames[sectionName]
	if not target then warn("⚠️ قسم غير موجود:", sectionName) return end

	local btn = Instance.new("TextButton")
	btn.Name = featureName.."Button"
	btn.Size = UDim2.new(0, 320, 0, 35)
	btn.BackgroundColor3 = Color3.fromRGB(30,30,30)
	btn.TextColor3 = Color3.fromRGB(255,255,255)
	btn.Font = Enum.Font.GothamSemibold
	btn.Text = featureName
	btn.TextSize = 14
	btn.Parent = target

	local bCorner = Instance.new("UICorner", btn)
	bCorner.CornerRadius = UDim.new(0, 6)

	local bStroke = Instance.new("UIStroke", btn)
	bStroke.Thickness = 1
	bStroke.Color = Color3.fromRGB(255,0,0)

	btn.MouseButton1Click:Connect(onClick)
end


