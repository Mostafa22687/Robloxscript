-- خاصية القفز العالي (Jump Boost)
local jumpEnabled = false
local normalJump = 50
local boostJump = 120

AddFeature("القفز العالي", "Power", function()

    jumpEnabled = not jumpEnabled
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:FindFirstChildOfClass("Humanoid")

    if hum then
        if jumpEnabled then
            hum.UseJumpPower = true
            hum.JumpPower = boostJump

            -- تحديث شكل الزر
            local btn = sectionFrames["Power"]:FindFirstChild("القفز العاليButton")
            if btn then
                btn.BackgroundColor3 = Color3.fromRGB(0, 160, 0)
                btn.Text = "القفز العالي: ON"
            end
        else
            hum.JumpPower = normalJump

            -- تحديث شكل الزر
            local btn = sectionFrames["Power"]:FindFirstChild("القفز العاليButton")
            if btn then
                btn.BackgroundColor3 = Color3.fromRGB(30,30,30)
                btn.Text = "القفز العالي: OFF"
            end
        end
    end
end)

-- زر ESP Player
local _espEnabled = false
local espObjects = {}

AddFeature("ESP Players", "ESP", function()
    _espEnabled = not _espEnabled

    -- تحديث نص الزر
    local parentFrame = sectionFrames["ESP"]
    if parentFrame then
        local myBtn = parentFrame:FindFirstChild("ESP PlayersButton")
        if myBtn and myBtn:IsA("TextButton") then
            myBtn.Text = _espEnabled and "ESP Players: ON" or "ESP Players: OFF"
            myBtn.BackgroundColor3 = _espEnabled and Color3.fromRGB(0,160,0) or Color3.fromRGB(30,30,30)
        end
    end

    if _espEnabled then
        -- تفعيل ESP لكل اللاعبين
        for _, plr in pairs(game:GetService("Players"):GetPlayers()) do
            if plr ~= game.Players.LocalPlayer and plr.Character then
                local head = plr.Character:FindFirstChild("Head")
                if head then
                    local billboard = Instance.new("BillboardGui")
                    billboard.Name = "ESP"
                    billboard.AlwaysOnTop = true
                    billboard.Size = UDim2.new(0, 100, 0, 20)
                    billboard.Adornee = head

                    local label = Instance.new("TextLabel", billboard)
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.Text = plr.Name
                    label.TextColor3 = Color3.fromRGB(255, 50, 50)
                    label.TextStrokeTransparency = 0.5
                    label.Font = Enum.Font.GothamBold
                    label.TextScaled = true

                    billboard.Parent = head
                    espObjects[plr] = billboard
                end
            end
        end

        -- إذا دخل لاعب جديد أثناء التفعيل
        game:GetService("Players").PlayerAdded:Connect(function(newPlr)
            newPlr.CharacterAdded:Connect(function(char)
                if _espEnabled then
                    task.wait(1)
                    local head = char:WaitForChild("Head")
                    local billboard = Instance.new("BillboardGui")
                    billboard.Name = "ESP"
                    billboard.AlwaysOnTop = true
                    billboard.Size = UDim2.new(0, 100, 0, 20)
                    billboard.Adornee = head

                    local label = Instance.new("TextLabel", billboard)
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.Text = newPlr.Name
                    label.TextColor3 = Color3.fromRGB(255, 50, 50)
                    label.TextStrokeTransparency = 0.5
                    label.Font = Enum.Font.GothamBold
                    label.TextScaled = true

                    billboard.Parent = head
                    espObjects[newPlr] = billboard
                end
            end)
        end)

    else
        -- تعطيل ESP وإزالة جميع الوسوم
        for plr, gui in pairs(espObjects) do
            if gui and gui.Parent then
                gui:Destroy()
            end
        end
        espObjects = {}
    end
end)

-- زر Unkill (ضعه داخل قاعدة المميزات حيث تستخدم AddFeature)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- حالة زر Unkill (محلية)
local _unkillEnabled = false

AddFeature("Unkill", "Settings", function()
    -- toggle الحالة
    _unkillEnabled = not _unkillEnabled

    -- تحديث مظهر الزر (يعثر على الزر المنشأ بنفس اسم النمط)
    local parentFrame = sectionFrames["Settings"]
    if parentFrame then
        local myBtn = parentFrame:FindFirstChild("UnkillButton")
        if myBtn and myBtn:IsA("TextButton") then
            myBtn.Text = _unkillEnabled and "Unkill: ON" or "Unkill: OFF"
            if _unkillEnabled then
                myBtn.BackgroundColor3 = Color3.fromRGB(0,160,0) -- أخضر عند التشغيل
            else
                myBtn.BackgroundColor3 = Color3.fromRGB(30,30,30) -- رمادي عند الإيقاف
            end
        end
    end

    -- محاولة إيجاد RemoteEvent اسم "unkill"
    local rem = ReplicatedStorage:FindFirstChild("unkill")
    if rem and rem:IsA("RemoteEvent") then
        -- إذا موجود على الـ ReplicatedStorage (عادة من جانب السيرفر) نطلقه
        pcall(function()
            rem:FireServer({ Command = "BlockDeathRemotes", Enable = _unkillEnabled })
        end)
    else
        -- إن لم يوجد: ننشئ RemoteEvent محلي (لن يصل للسيرفر) ثم نطلقة كإجراء احترازي — نُعلم المستخدم عبر طباعة
        local created = Instance.new("RemoteEvent")
        created.Name = "unkill"
        created.Parent = ReplicatedStorage -- ملاحظة: إنشاءه من العميل لن يخلقه على السيرفر
        pcall(function()
            created:FireServer({ Command = "BlockDeathRemotes", Enable = _unkillEnabled })
        end)
        warn("[Unkill] RemoteEvent 'unkill' غير موجود على السيرفر. تم إنشاء نسخة محلية فقط — لكي تعمل منع الموت يجب أن يكون على السيرفر RemoteEvent/Handler يدعم 'BlockDeathRemotes'.")
    end
end)

